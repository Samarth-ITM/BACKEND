      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{student2Token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": \"{{room2Id}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/allocations",
          "host": ["{{baseUrl}}"],
          "path": ["allocations"]
        }
      }
    },
    {
      "name": "15. Warden Rejects Allocation (Test Rejection)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
