{
  "info": {
    "name": "Hostel Room Allocation API",
    "description": "Postman Collection for Hostel Room Allocation System - Sequential Test Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "wardenToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "student2Token",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentEmail",
      "value": "student_test@hostel.com",
      "type": "string"
    },
    {
      "key": "wardenEmail",
      "value": "warden_test@hostel.com",
      "type": "string"
    },
    {
      "key": "student2Email",
      "value": "student2_test@hostel.com",
      "type": "string"
    },
    {
      "key": "roomNumber",
      "value": "101",
      "type": "string"
    },
    {
      "key": "roomId",
      "value": "",
      "type": "string"
    },
    {
      "key": "room2Id",
      "value": "",
      "type": "string"
    },
    {
      "key": "allocationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "allocation2Id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register Student",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const ts = Date.now();",
              "pm.collectionVariables.set(\"studentEmail\", \"student_\" + ts + \"@test.com\");",
              "pm.collectionVariables.set(\"wardenEmail\", \"warden_\" + ts + \"@test.com\");",
              "pm.collectionVariables.set(\"student2Email\", \"student2_\" + ts + \"@test.com\");",
              "pm.collectionVariables.set(\"roomNumber\", \"R\" + ts.toString().slice(-4));"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"password123\",\n  \"role\": \"student\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "2. Login Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const res = pm.response.json();",
              "if (res.token) {",
              "    pm.collectionVariables.set(\"studentToken\", res.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "3. Register Warden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob Warden\",\n  \"email\": \"{{wardenEmail}}\",\n  \"password\": \"password123\",\n  \"role\": \"warden\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "4. Login Warden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const res = pm.response.json();",
              "if (res.token) {",
              "    pm.collectionVariables.set(\"wardenToken\", res.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{wardenEmail}}\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "5. Get Rooms",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/rooms",
          "host": ["{{baseUrl}}"],
          "path": ["rooms"]
        }
      }
    },
    {
      "name": "6. Create Room",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const res = pm.response.json();",
              "if (res._id) {",
              "    pm.collectionVariables.set(\"roomId\", res._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{wardenToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomNumber\": \"{{roomNumber}}\",\n  \"capacity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/rooms",
          "host": ["{{baseUrl}}"],
          "path": ["rooms"]
        }
      }
    },
    {
      "name": "7. Update Room",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{wardenToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"capacity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/rooms/{{roomId}}",
          "host": ["{{baseUrl}}"],
          "path": ["rooms", "{{roomId}}"]
        }
      }
    },
    {
      "name": "8. Create Allocation Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const res = pm.response.json();",
              "if (res._id) {",
              "    pm.collectionVariables.set(\"allocationId\", res._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": \"{{roomId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/allocations",
          "host": ["{{baseUrl}}"],
          "path": ["allocations"]
        }
      }
    },
    {
      "name": "9. Get Allocations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{wardenToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/allocations",
          "host": ["{{baseUrl}}"],
          "path": ["allocations"]
        }
      }
    },
    {
      "name": "10. Approve Allocation as Warden",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{wardenToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"approved\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/allocations/{{allocationId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["allocations", "{{allocationId}}", "status"]
        }
      }
    },
    {
      "name": "11. Register Student 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Student Two\",\n  \"email\": \"{{student2Email}}\",\n  \"password\": \"password123\",\n  \"role\": \"student\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "12. Login Student 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const res = pm.response.json();",
              "if (res.token) {",
              "    pm.collectionVariables.set(\"student2Token\", res.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{student2Email}}\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "13. Create Room 2 (for Rejection & Delete tests)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const res = pm.response.json();",
              "if (res._id) {",
              "    pm.collectionVariables.set(\"room2Id\", res._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{wardenToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomNumber\": \"{{roomNumber}}_B\",\n  \"capacity\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/rooms",
          "host": ["{{baseUrl}}"],
          "path": ["rooms"]
        }
      }
    },
    {
      "name": "14. Student 2 Requests Room 2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const res = pm.response.json();",
              "if (res._id) {",
              "    pm.collectionVariables.set(\"allocation2Id\", res._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
