          },
          {
            "key": "Authorization",
            "value": "Bearer {{wardenToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"rejected\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/allocations/{{allocation2Id}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["allocations", "{{allocation2Id}}", "status"]
        }
      }
    },
    {
      "name": "16. Test Full-Room Capacity Block",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Room is full\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{student2Token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": \"{{roomId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/allocations",
          "host": ["{{baseUrl}}"],
          "path": ["allocations"]
        }
      }
    },
    {
      "name": "17. Test Authorization Block (Student tries to create room)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden for student creating room\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomNumber\": \"UNAUTHORIZED\",\n  \"capacity\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/rooms",
          "host": ["{{baseUrl}}"],
          "path": ["rooms"]
        }
      }
    },
    {
      "name": "18. Delete Room (Empty Room 2 after tests completed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{wardenToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/rooms/{{room2Id}}",
          "host": ["{{baseUrl}}"],
          "path": ["rooms", "{{room2Id}}"]
        }
